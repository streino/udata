<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:dcat="http://www.w3.org/ns/dcat#"
  xmlns:dcterms="http://purl.org/dc/terms/"
>
  <dcat:Catalog rdf:about="http://data.test.org/">
    <dcterms:title>Sample DCAT Catalog</dcterms:title>
    <dcat:dataset>
      <!-- Standard (GeoNetwork-style) resource reference: the parent series is referenced by its
           resource URI and carries no dct:identifier, so the child's inSeries is a pure URI. -->
      <dcat:Dataset rdf:about="http://data.test.org/api/records/parent-series">
        <rdf:type rdf:resource="http://www.w3.org/ns/dcat#DatasetSeries"/>
        <dcterms:title>Parent Series</dcterms:title>
        <dcterms:description>Parent description</dcterms:description>
      </dcat:Dataset>
    </dcat:dataset>
    <dcat:dataset>
      <dcat:Dataset rdf:about="http://data.test.org/api/records/child">
        <dcterms:title>Child dataset</dcterms:title>
        <dcterms:identifier>child</dcterms:identifier>
        <dcterms:description>Child description</dcterms:description>
        <dcat:inSeries rdf:resource="http://data.test.org/api/records/parent-series"/>
      </dcat:Dataset>
    </dcat:dataset>
  </dcat:Catalog>
</rdf:RDF>
