<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:dcat="http://www.w3.org/ns/dcat#"
  xmlns:dct="http://purl.org/dc/terms/"
  xmlns:foaf="http://xmlns.com/foaf/0.1/"
>
  <dcat:Catalog rdf:about="http://data.test.org/">
    <dct:title>Sample DCAT Catalog</dct:title>
    <dcat:dataset>
      <!-- Real SEMIC/ISO-19139 scenario: the parent series node is output with its own record
           URI as rdf:about, and its record UUID is carried as the dct:identifier of the node it
           points to via isPrimaryTopicOf (no rdf:about on that node, same as geonetwork). The
           child references the parent through `urn:iso19139:parent:<record-uuid>`. -->
      <dcat:Dataset rdf:about="http://data.test.org/records/parent">
        <rdf:type rdf:resource="http://www.w3.org/ns/dcat#DatasetSeries"/>
        <dct:title>Parent series</dct:title>
        <dct:identifier>series</dct:identifier>
        <dct:description>Parent description</dct:description>
        <foaf:isPrimaryTopicOf>
          <rdf:Description>
            <rdf:type rdf:resource="http://www.w3.org/ns/dcat#CatalogRecord"/>
            <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">18852322-ff6f-4f11-a4eb-bde356c8032d</dct:identifier>
          </rdf:Description>
        </foaf:isPrimaryTopicOf>
      </dcat:Dataset>
    </dcat:dataset>
    <dcat:dataset>
      <dcat:Dataset rdf:about="http://data.test.org/records/child">
        <dct:title>Child dataset</dct:title>
        <dct:identifier>child</dct:identifier>
        <dct:description>Child description</dct:description>
        <dcat:inSeries>urn:iso19139:parent:18852322-ff6f-4f11-a4eb-bde356c8032d</dcat:inSeries>
      </dcat:Dataset>
    </dcat:dataset>
  </dcat:Catalog>
</rdf:RDF>
